DJANGO_DEBUG=true
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Required when DJANGO_DEBUG=false (set to your actual domain)
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com

# Database (Railway automatically provides DATABASE_URL when PostgreSQL is attached)
# If DATABASE_URL is set, it will be used automatically.
# DATABASE_URL=postgresql://postgres:password@host:5432/railway

# Or standalone Postgres variables:
POSTGRES_DB=moomeen
POSTGRES_USER=postgres
POSTGRES_PASSWORD=yourpassword
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Leave all database vars blank for local SQLite development